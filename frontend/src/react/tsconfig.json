{
  // React 子树（ADR-0031）。这一层只放宽 boardui/ 要的那两条，其余继承 frontend/tsconfig.json；
  // Vite 与 tsc 都按「离文件最近的 tsconfig」找配置。
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    // boardui/ 逐字复制上游源码，上游没有按这两条写；在这里放宽，而不是改上游文件。
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false,
    // evilcharts/ 同样逐字复制，上游用普通 import 取 recharts 的类型（`RectRadius`、`TypedDataKey`）；
    // `isolatedModules` 仍开着，转译时只被当类型用的 import 照常剥掉。
    "verbatimModuleSyntax": false,
    "paths": {
      "next/link": ["./components/board-navigation-link.tsx"],
      // EvilCharts 源码按 shadcn 项目的路径写 import；最长前缀优先，排在 `@/*` 之前命中。
      "@/registry/*": ["./evilcharts/registry/*"],
      "@/lib/utils": ["./charts/cn.ts"],
      "@/*": ["./boardui/*"],
      "@videodrome/legacy/core": ["../core/index.ts"],
      "@videodrome/legacy/ui": ["../ui-kit/index.ts"],
      "@videodrome/legacy/jav-title": ["../core/jav-title.ts"],
      "@videodrome/legacy/tags": ["../core/tags.ts"],
      "@videodrome/card-art": ["../card-art/index.ts"],
      "@videodrome/appearance": ["../appearance/index.ts"],
      "@videodrome/query": ["../query/index.ts"],
      "@videodrome/history": ["../history/index.ts"],
      "@videodrome/shell": ["../shell/index.ts"]
    }
  },
  "include": ["./", "../../test/react"],
  "exclude": []
}
